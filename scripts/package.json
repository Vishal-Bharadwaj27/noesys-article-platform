{
  "name": "article-seed-script",
  "version": "1.0.0",
  "description": "Seed script to import articles and article types into D1 from .docx/.md files",
  "type": "module",
  "main": "seed.ts",
  "scripts": {
    "seed": "node seed.js",
    "seed:dry": "node seed.js --dry-run",
    "seed:verbose": "node seed.js --verbose",
    "seed:test": "node seed.js --dry-run --verbose"
  },
  "dependencies": {
    "csv-parse": "^5.5.2",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.6.0"
  },
  "devDependencies": {
    "better-sqlite3": "^9.2.2",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}